# Environment variables for Safar Express

# SQLite Database (Default for development)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Uncomment and update when switching to Postgres):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safar_express?schema=public"

# App Secret / Auth
NEXTAUTH_SECRET="safar_express_secret_key_change_in_production"
NEXTAUTH_URL="http://localhost:3000"
